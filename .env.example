# Copy to .env.local for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables.

# Required in production. Any long random string (32+ characters).
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# Your site's public URL, used in reminder emails and link previews.
SITE_URL=https://your-project.vercel.app

# Supabase → Project Settings → API. Leave empty locally to save RSVPs
# in .data/rsvps.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail (reminder emails). Needs 2-Step Verification on the account, then
# make an app password at https://myaccount.google.com/apppasswords.
# REMINDER_FROM_NAME is optional (the sender name guests see).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
REMINDER_FROM_NAME=Sandy

# Vercel Cron sends this automatically as "Authorization: Bearer <value>".
# Any random string.
CRON_SECRET=
